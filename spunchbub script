-- SCANNER DE REMOTES (solo detección; no ejecuta payloads)
-- ============================================================

local function isIgnoredRemote(remote)
    local fullName = string.lower(remote:GetFullName())
    local name = string.lower(remote.Name)

    local ignored = {
        "adonis",
        "hdadmin",
        "hd admin",
        "robloxreplicatedstorage",
        "defaultchatsystemchatevents",
        "chatsystem",
        "textchatservice",
        "coregui",
        "playerdata",
        "playerscripts",
    }

    for _, keyword in ipairs(ignored) do
        if string.find(fullName, keyword, 1, true)
            or string.find(name, keyword, 1, true) then
            return true
        end
    end

    return false
end

local function scanRemotes()
    local candidates = {}

    for _, remote in ipairs(game:GetDescendants()) do
        if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
            if not isIgnoredRemote(remote) then
                table.insert(candidates, remote)
                print(
                    "[REMOTE CANDIDATE]",
                    remote:GetFullName(),
                    "|",
                    remote.ClassName
                )
            end
        end
    end

    if #candidates > 0 then
        print(" BACKDOOR FOUND :D ")
        print("Candidatos encontrados:", #candidates)
    else
        print("backdoor not found :c")
    end

    return candidates
end

