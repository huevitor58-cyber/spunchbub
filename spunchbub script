-- R6 LOCAL / OTROS JUGADORES SIGUEN VIENDO AL JUGADOR COMO R15
-- ============================================================

local function convertLocalCharacterToR6()
    local player = Players.LocalPlayer
    local oldCharacter = player.Character
    if not oldCharacter then return end

    local oldPivot = oldCharacter:GetPivot()

    local ok, err = pcall(function()
        local description = Players:GetHumanoidDescriptionFromUserId(player.UserId)

        local newCharacter = Players:CreateHumanoidModelFromDescription(
            description,
            Enum.HumanoidRigType.R6
        )

        local humanoid = newCharacter:FindFirstChildOfClass("Humanoid")
        local root = newCharacter:FindFirstChild("HumanoidRootPart")

        if not humanoid or not root then
            newCharacter:Destroy()
            error("No se pudo crear el R6.")
        end

        newCharacter.Name = oldCharacter.Name
        newCharacter:PivotTo(oldPivot)
        newCharacter.Parent = workspace

        player.Character = newCharacter

        humanoid.AutoRotate = true
        humanoid.PlatformStand = false

        local camera = workspace.CurrentCamera
        if camera then
            camera.CameraType = Enum.CameraType.Custom
            camera.CameraSubject = humanoid
        end

        -- Animaciones R6 básicas.
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = humanoid
        end

        local animationIds = {
            idle = "rbxassetid://180435571",
            walk = "rbxassetid://180426354",
            jump = "rbxassetid://125750702",
            fall = "rbxassetid://180436148",
            climb = "rbxassetid://180436334",
            sit = "rbxassetid://178130996",
        }

        local tracks = {}

        local function makeTrack(name, id, looped, priority)
            local animation = Instance.new("Animation")
            animation.Name = "LocalR6_" .. name
            animation.AnimationId = id

            local track = animator:LoadAnimation(animation)
            track.Looped = looped
            track.Priority = priority
            tracks[name] = track
        end

        makeTrack("idle", animationIds.idle, true, Enum.AnimationPriority.Idle)
        makeTrack("walk", animationIds.walk, true, Enum.AnimationPriority.Movement)
        makeTrack("jump", animationIds.jump, false, Enum.AnimationPriority.Action)
        makeTrack("fall", animationIds.fall, true, Enum.AnimationPriority.Action)
        makeTrack("climb", animationIds.climb, true, Enum.AnimationPriority.Movement)
        makeTrack("sit", animationIds.sit, true, Enum.AnimationPriority.Movement)

        local currentTrack

        local function play(track)
            if currentTrack == track and track.IsPlaying then
                return
            end

            if currentTrack then
                currentTrack:Stop(0.12)
            end

            currentTrack = track
            if track then
                track:Play(0.12)
            end
        end

        humanoid.Running:Connect(function(speed)
            if speed > 0.1 then
                play(tracks.walk)
            else
                play(tracks.idle)
            end
        end)

        humanoid.StateChanged:Connect(function(_, state)
            if state == Enum.HumanoidStateType.Jumping then
                play(tracks.jump)
            elseif state == Enum.HumanoidStateType.Freefall then
                play(tracks.fall)
            elseif state == Enum.HumanoidStateType.Climbing then
                play(tracks.climb)
            elseif state == Enum.HumanoidStateType.Seated then
                play(tracks.sit)
            elseif state == Enum.HumanoidStateType.Landed then
                if humanoid.MoveDirection.Magnitude > 0.1 then
                    play(tracks.walk)
                else
                    play(tracks.idle)
                end
            end
        end)

        play(tracks.idle)

        -- Esta conversión es local: no cambia el rig que el servidor
        -- replica a los demás jugadores. Por eso ellos siguen viendo R15.
        if oldCharacter and oldCharacter.Parent then
            oldCharacter:Destroy()
        end
    end)

    if not ok then
        warn("R6 error:", err)
    end
end

R6Button_1.MouseButton1Click:Connect(convertLocalCharacterToR6)

